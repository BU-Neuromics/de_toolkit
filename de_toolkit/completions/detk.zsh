_shtab_detk() {
  local context state line curcontext="$curcontext" one_or_more='(*)' remainder='(-)*:' default='*::: :->detk'

  # Add default positional/remainder specs only if none exist, and only once per session
  if (( ! _shtab_detk_defaults_added )); then
    if (( ${_shtab_detk_options[(I)${(q)one_or_more}*]} +          ${_shtab_detk_options[(I)${(q)remainder}*]} +          ${_shtab_detk_options[(I)${(q)default}]} == 0 )); then
      _shtab_detk_options+=(': :_shtab_detk_commands' '*::: :->detk')
    fi
    _shtab_detk_defaults_added=1
  fi
  _arguments -C -s $_shtab_detk_options

  case $state in
    detk)
      words=($line[1] "${words[@]}")
      (( CURRENT += 1 ))
      curcontext="${curcontext%:*:*}:_shtab_detk-$line[1]:"
      case $line[1] in
        completion) _arguments -C -s $_shtab_detk_completion_options ;;
        de) _shtab_detk_de ;;
        enrich) _shtab_detk_enrich ;;
        filter) _arguments -C -s $_shtab_detk_filter_options ;;
        help) _arguments -C -s $_shtab_detk_help_options ;;
        norm) _shtab_detk_norm ;;
        outlier) _shtab_detk_outlier ;;
        report) _shtab_detk_report ;;
        stats) _shtab_detk_stats ;;
        transform) _shtab_detk_transform ;;
        util) _shtab_detk_util ;;
        wrapr) _shtab_detk_wrapr ;;
      esac
  esac
}

